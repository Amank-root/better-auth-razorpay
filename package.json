{
  "name": "@amank-root/better-auth-razorpay",
  "version": "1.2.0",
  "description": "Full Razorpay plugin for Better Auth: subscriptions and one-time orders, customers, plans, webhooks.",
  "author": {
    "name": "Aman Kushwaha",
    "url": "https://amankushwaha.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amank-root/better-auth-razorpay"
  },
  "homepage": "https://github.com/Amank-root/better-auth-razorpay#readme",
  "bugs": {
    "url": "https://github.com/Amank-root/better-auth-razorpay/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "razorpay",
    "razorpay-plugin",
    "payment",
    "payments",
    "payment-gateway",
    "subscription",
    "subscriptions",
    "recurring-payments",
    "one-time-payment",
    "orders",
    "customers",
    "plans",
    "webhooks",
    "typescript",
    "authentication",
    "bun",
    "npm"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "better-auth": "^1.7.0",
    "@better-auth/core": "^1.7.0",
    "@tanstack/react-query": "^5.104.3",
    "typescript": "^5.6.3",
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "defu": "^6.1.7",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/core": "^1.7.10",
    "better-auth": "^1.7.10",
    "@tanstack/react-query": "^5.104.3",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
