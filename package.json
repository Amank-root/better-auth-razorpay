{
  "name": "@amank-root/better-auth-razorpay",
  "version": "1.1.0",
  "description": "Full Razorpay plugin for Better Auth: subscriptions and one-time orders, customers, plans, webhooks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "better-auth": "^1.7.0",
    "@better-auth/core": "^1.7.0",
    "typescript": "^5.6.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "defu": "^6.1.7",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/core": "^1.7.10",
    "@tanstack/react-query": "^5.104.3",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
